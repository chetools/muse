#!/usr/bin/env bash
# Grading poll hook for HW Signing v2. Template: at setup, copy this
# file to ~/hooks/scripts/grading-poll.sh with __CONFIG_PATH__ replaced
# by the absolute path of config.json in the local-grading-poll skill
# folder, then register it with the hooks tools (see the skill's
# SKILL.md).
#
# The script asks the grading worker one cheap question — is a grading
# job waiting? — with the grading token. It ends with exactly one
# silent or wake call, as the hook protocol requires:
#   pending 0       -> silent (nothing to grade)
#   pending > 0     -> wake, payload {"pending": n}
#   401             -> silent; the refusal is logged once per revocation
#                      (a flag file under ~/hooks/state/), not every minute
#   fetch failure   -> silent; the failure is logged
# State writes are skipped on dry runs (HATCH_HOOK_DRY_RUN=1), so a dry
# run never consumes the one-time 401 log. The script holds no
# credential itself: it reads the grading token from the config at
# run time, and sends it only as the X-Grading-Token header.
set -euo pipefail
source "$HATCH_HOOK_RUNTIME"

CONFIG="__CONFIG_PATH__"
STATE_DIR="$HOME/hooks/state"
FLAG_401="$STATE_DIR/grading-poll-401.flag"

state_write() {
  # state_write <command...>: run a state-changing command unless dry run.
  if [ "${HATCH_HOOK_DRY_RUN:-0}" != "1" ]; then "$@"; fi
}

if [ ! -f "$CONFIG" ]; then
  log "grading poll: config missing" "{\"config\":\"$CONFIG\"}"
  silent "config.json not found; grading-poll setup is incomplete" '{}'
  exit 0
fi

WORKER="$(jq -r '.worker // ""' "$CONFIG")"
GRADING_TOKEN="$(jq -r '.gradingToken // ""' "$CONFIG")"
if [ -z "$WORKER" ] || [ -z "$GRADING_TOKEN" ]; then
  log "grading poll: config incomplete" '{}'
  silent "config.json lacks worker or gradingToken" '{}'
  exit 0
fi
WORKER="${WORKER%/}"

BODY="$(mktemp)"
trap 'rm -f "$BODY"' EXIT
CODE="$(curl --silent --max-time 10 -o "$BODY" -w '%{http_code}' \
  -H "X-Grading-Token: $GRADING_TOKEN" "$WORKER/grading/pending" || echo 000)"

if [ "$CODE" = "401" ]; then
  if [ ! -f "$FLAG_401" ]; then
    log "grading poll: grading token refused (401); revoked or regenerated" '{}'
    state_write mkdir -p "$STATE_DIR"
    state_write touch "$FLAG_401"
  fi
  silent "grading token refused (401)" '{}'
  exit 0
fi

if [ "$CODE" != "200" ]; then
  log "grading poll: fetch failed" "{\"http\":\"$CODE\"}"
  silent "poll fetch failed (HTTP $CODE)" '{}'
  exit 0
fi

# A working poll clears any earlier 401 flag, so a later revocation is
# logged once again.
state_write rm -f "$FLAG_401"

# /grading/pending returns a JSON array; its length is the pending count.
PENDING="$(jq -r 'length // 0' "$BODY")"
if [ "$PENDING" -gt 0 ] 2>/dev/null; then
  wake "grading job waiting" "{\"pending\": $PENDING}"
else
  silent "no pending jobs" '{"pending": 0}'
fi
