#!/usr/bin/env bash
# Grading poll hook for HW Signing v2. Template: at setup, copy this
# file to ~/hooks/scripts/grading-poll.sh with __CONFIG_PATH__ replaced
# by the absolute path of config.json in the local-grading-poll skill
# folder, then register it with the hooks tools (see the skill's
# SKILL.md).
#
# The script asks the grading worker one cheap question — is a grading
# job waiting? — with the grading token. It ends with exactly one
# silent or wake call, as the hook protocol requires:
#   pending 0       -> silent (nothing to grade), unless the sweeper
#                      condition below fires
#   pending > 0     -> wake, payload {"pending": n, "room": r}
#   own claim aged 5-15 min with no confirmed post and not already
#   marked swept (sweeper,
#   2026-11-27)     -> wake, payload {"pending": n, "room": r,
#                      "sweep": [job_id, ...]}, even when pending is 0
#   401             -> silent; the refusal is logged once per revocation
#                      (a flag file under ~/hooks/state/), not every minute
#   fetch failure   -> silent; the failure is logged
# State writes are skipped on dry runs (HATCH_HOOK_DRY_RUN=1), so a dry
# run never consumes the one-time 401 log. The script holds no
# credential itself: it reads the grading token from the config at
# run time, and sends it only as the X-Grading-Token header.
set -euo pipefail
source "$HATCH_HOOK_RUNTIME"

CONFIG="__CONFIG_PATH__"
STATE_DIR="$HOME/hooks/state"
FLAG_401="$STATE_DIR/grading-poll-401.flag"

state_write() {
  # state_write <command...>: run a state-changing command unless dry run.
  if [ "${HATCH_HOOK_DRY_RUN:-0}" != "1" ]; then "$@"; fi
}

if [ ! -f "$CONFIG" ]; then
  log "grading poll: config missing" "{\"config\":\"$CONFIG\"}"
  silent "config.json not found; grading-poll setup is incomplete" '{}'
  exit 0
fi

WORKER="$(jq -r '.worker // ""' "$CONFIG")"
GRADING_TOKEN="$(jq -r '.gradingToken // ""' "$CONFIG")"
if [ -z "$WORKER" ] || [ -z "$GRADING_TOKEN" ]; then
  log "grading poll: config incomplete" '{}'
  silent "config.json lacks worker or gradingToken" '{}'
  exit 0
fi
WORKER="${WORKER%/}"

BODY="$(mktemp)"
trap 'rm -f "$BODY"' EXIT
CODE="$(curl --silent --max-time 10 -o "$BODY" -w '%{http_code}' \
  -H "X-Grading-Token: $GRADING_TOKEN" "$WORKER/grading/pending" || echo 000)"

if [ "$CODE" = "401" ]; then
  if [ ! -f "$FLAG_401" ]; then
    log "grading poll: grading token refused (401); revoked or regenerated" '{}'
    state_write mkdir -p "$STATE_DIR"
    state_write touch "$FLAG_401"
  fi
  silent "grading token refused (401)" '{}'
  exit 0
fi

if [ "$CODE" != "200" ]; then
  log "grading poll: fetch failed" "{\"http\":\"$CODE\"}"
  silent "poll fetch failed (HTTP $CODE)" '{}'
  exit 0
fi

# A working poll clears any earlier 401 flag, so a later revocation is
# logged once again.
state_write rm -f "$FLAG_401"

# /grading/pending returns a JSON array; its length is the pending count.
PENDING="$(jq -r 'length // 0' "$BODY")"
case "$PENDING" in *[!0-9]*|'') PENDING=0 ;; esac

# Ledger state, read once for both decisions below. The wake procedure
# records each claim in ~/hooks/state/grading-active.json and removes
# the entry when the result post is confirmed, so an entry still
# present is a claim this account has not finished.
NOW="$(date +%s)"
LEDGER="$HOME/hooks/state/grading-active.json"
ACTIVE=0
SWEEP='[]'
if [ -f "$LEDGER" ]; then
  # In-flight cap (2026-11-20): entries older than 15 minutes (the
  # claim lease) are stale and do not count against the cap of 7.
  ACTIVE="$(jq --argjson cutoff "$((NOW - 900))" '[.[] | select(.claimed_at > $cutoff)] | length' "$LEDGER" 2>/dev/null || echo 0)"
  case "$ACTIVE" in *[!0-9]*|'') ACTIVE=0 ;; esac
  # Sweeper (2026-11-27): an own claim aged between 5 and 15 minutes
  # with no confirmed post is a claim a previous run dropped or left
  # unfinished. Wake for it even when nothing is queued, so the wake
  # procedure can post its result file or re-grade it under its still
  # live claim instead of waiting out the lease. Entries at or past
  # 15 minutes are excluded: the worker has returned or is returning
  # those jobs to the pending list, where the ordinary path takes them.
  SWEEP="$(jq -c --argjson lo "$((NOW - 900))" --argjson hi "$((NOW - 300))" '[.[] | select(.claimed_at > $lo and .claimed_at <= $hi and (.swept // false) != true) | .job_id]' "$LEDGER" 2>/dev/null || echo '[]')"
  case "$SWEEP" in '['*']') : ;; *) SWEEP='[]' ;; esac
fi
ROOM=$((7 - ACTIVE))
if [ "$ROOM" -lt 0 ]; then ROOM=0; fi
SWEEP_N="$(printf '%s' "$SWEEP" | jq -r 'length' 2>/dev/null || echo 0)"
case "$SWEEP_N" in *[!0-9]*|'') SWEEP_N=0 ;; esac

if [ "$SWEEP_N" -gt 0 ]; then
  wake "own stale claims to sweep" "{\"pending\": $PENDING, \"room\": $ROOM, \"sweep\": $SWEEP}"
elif [ "$PENDING" -gt 0 ]; then
  if [ "$ROOM" -le 0 ]; then
    silent "grading job waiting; at grading capacity" "{\"pending\": $PENDING, \"active\": $ACTIVE}"
  else
    wake "grading job waiting" "{\"pending\": $PENDING, \"room\": $ROOM}"
  fi
else
  silent "no pending jobs" '{"pending": 0}'
fi
